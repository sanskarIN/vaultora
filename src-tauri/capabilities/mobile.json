{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile-main",
  "description": "Minimum Android and iOS permissions required by Vaultora.",
  "windows": ["main"],
  "platforms": ["android", "iOS"],
  "permissions": [
    "core:default",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-file",
    "fs:allow-write-file"
  ]
}
