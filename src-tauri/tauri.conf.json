{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vaultora",
  "version": "0.2.0",
  "identifier": "in.sanskar.vaultora",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Vaultora",
        "width": 1220,
        "height": 780,
        "minWidth": 820,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Local-first encrypted password manager",
    "longDescription": "Vaultora stores logins, secure notes, and identities in an encrypted local vault.",
    "copyright": "Copyright © 2026 Sanskar",
    "license": "Apache-2.0"
  }
}
