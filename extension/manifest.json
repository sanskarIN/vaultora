{
  "manifest_version": 3,
  "name": "Vaultora",
  "version": "0.2.0",
  "description": "Secure browser companion for the local-first Vaultora password manager.",
  "permissions": ["activeTab", "nativeMessaging", "scripting"],
  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Vaultora",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "vaultora@sanskar.in"
    }
  }
}
